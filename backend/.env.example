# =============================================================================
# EduRankAI HRMS ("HumanOS") — environment template
# =============================================================================
# Copy to backend/.env and fill in real values. Every variable below is read by
# backend/src/config/index.ts; that file is the authoritative list and it will
# refuse to start if something required is missing or unsafe.
#
# Each entry says WHAT IT DOES and WHAT BREAKS IF IT IS WRONG, because several
# of these were silently wrong in this repository until 2026-08-22.
#
# NEVER commit a filled-in .env. The root .gitignore excludes .env and every
# .env.* variant, and re-includes this template only.
# =============================================================================

# --- application ------------------------------------------------------------

# development | production | test.
# `production` switches on assertProductionSafety() in config/index.ts, which
# refuses to boot on a weak JWT_SECRET, a superuser DATABASE_URL, DEMO_MODE,
# disabled RLS, a fail-open audit trail, a loopback CORS origin or debug logging.
# If this is left at `development` on a real deployment, every one of those
# guards is skipped — that is exactly how the old /api/auth/demo backdoor stayed
# reachable.
NODE_ENV=development

# TCP port the Fastify server binds.
# Wrong: the reverse proxy 502s. Note the docs and the gate historically used
# 3000 for dev and 3001 for the production smoke instance.
PORT=3000

# Bind address. Use 127.0.0.1 when a reverse proxy on the same host is the only
# client; 0.0.0.0 exposes the API on every interface.
HOST=0.0.0.0

# fatal | error | warn | info | debug | trace.
# debug/trace log request bodies, which for this API means passwords, health
# free-text and payroll figures land on disk. Production refuses both.
LOG_LEVEL=info

# --- database ---------------------------------------------------------------

# PostgreSQL connection string for the APPLICATION role — not a superuser.
# Superusers and table owners BYPASS row-level security, which silently voids
# every policy in migrations/033_rls_and_grants.sql and every GRANT in the
# earlier migrations. The operator must create the hrms_app role and point this
# at it (see docs/REMEDIATION_RUNBOOK.md) or RLS is decorative.
# Production also requires a password and sslmode=require or stricter.
DATABASE_URL=postgresql://hrms_app:CHANGE_ME@localhost:5432/edurankai?sslmode=require

# Minimum idle connections kept in the pool.
# Too high on a small server wastes backend slots; 0 adds latency to the first
# request after an idle period.
DATABASE_POOL_MIN=2

# Maximum concurrent connections from this process.
# Must stay below PostgreSQL max_connections divided by the number of app
# instances, or connections start being refused under load.
DATABASE_POOL_MAX=20

# Set app.person_id / app.roles as transaction-local settings on every
# request-scoped query so the RLS policies can see who is asking.
# false = every policy still exists but matches nothing useful, and the API
# becomes the only thing standing between a caller and another employee's rows.
# Production refuses to start with this disabled.
DB_RLS_ENABLED=true

# --- authorization engine (Cerbos) -----------------------------------------

# Cerbos was never actually wired up in this system. backend/src/authz/cerbos.ts
# is deny-only by design and the four files under policies/ are NOT valid Cerbos
# grammar (they are Kubernetes-shaped and carry NOT ENFORCED banners).
# Authorization is enforced by backend/src/lib/access.ts and by hand in the
# route handlers. These variables exist for the day a real PDP is deployed.

# When false, no connection is attempted and no route may claim a Cerbos
# decision. Turning it on without a running, policy-loaded Cerbos means every
# call that asks for a decision gets DENY — fail-closed, but the app will look
# broken rather than insecure.
CERBOS_ENABLED=false

# Host and port of the Cerbos PDP. Ignored while CERBOS_ENABLED=false.
CERBOS_HOST=localhost
CERBOS_PORT=3592

# Directory Cerbos would load policies from. The files there today would be
# rejected by a real Cerbos build; do not point a live PDP at them expecting
# them to grant anything.
CERBOS_POLICY_DIR=./policies

# How often a running Cerbos re-reads the policy directory.
CERBOS_POLL_INTERVAL=60s

# --- tokens and sessions ----------------------------------------------------

# HS256 signing key for access tokens. Minimum 32 characters everywhere, and in
# production at least 48 characters, at least 16 distinct characters, and not
# matching any development placeholder pattern.
# Generate one with:  openssl rand -base64 48
# The committed value used to be `edurankai-hrms-demo-development-secret-key-2026`
# — guessable, published, and enough on its own to mint a token for any employee.
# If this key ever leaks, every outstanding session is forgeable: rotate it and
# accept that all users are logged out.
JWT_SECRET=CHANGE_ME__run__openssl_rand_base64_48

# `iss` and `aud` claims. Verification checks both, so changing either while
# tokens are outstanding invalidates them (a deliberate, cheap revocation lever).
JWT_ISSUER=edurankai-hrms
JWT_AUDIENCE=edurankai-hrms-api

# Access-token lifetime (jose duration string: 30m, 1h, …).
# Short on purpose: the token carries NO roles, so authority is re-derived from
# the database per request. Making this long re-creates the old problem where a
# revoked or demoted user keeps working until expiry.
JWT_TTL=30m

# Refresh-token lifetime in days. Refresh tokens are opaque, stored only as a
# SHA-256 hash, and rotated on every use; presenting an already-rotated one
# revokes the whole session. Long values widen the theft window.
REFRESH_TOKEN_TTL_DAYS=14

# How long a derived role set may be reused before it is re-read from the
# database. This is the window in which a just-revoked role still works.
# 0 disables the cache (correct but a query per request); large values recreate
# stale authority.
ROLE_CACHE_TTL_MS=15000

# --- external identity provider (optional) ----------------------------------
# All four are optional. The local username/password path in
# health.user_accounts is the fallback; leave these unset until a real IdP
# exists. Setting a provider URL without the client id/secret/redirect will
# fail at the first authorization round-trip, not at boot.
# OIDC_PROVIDER_URL=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://hrms.example.com/callback

# --- request limits and login throttling ------------------------------------

# Browser origin allowed to call this API with credentials.
# A wildcard or a loopback address in production lets any page a user visits
# read their HRMS data; production refuses both.
CORS_ORIGIN=http://localhost:5173

# Global rate limit: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW ms.
# (RATE_LIMIT_WINDOW_MS / RATE_LIMIT_MAX_REQUESTS are the older aliases the
# config still reads; keep all four consistent or the effective limit depends on
# which one the plugin happens to use.)
# Too high is a free credential-stuffing and scraping budget; too low breaks the
# dashboard, which fans out several calls per page load.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Failed password attempts before an account is locked, and for how long.
# The counter and lock live on health.user_accounts, so this survives restarts
# and applies per account rather than per IP. Setting the ceiling very high
# turns password guessing back into an unmetered activity; setting it to 1 or 2
# makes a shared office IP a denial-of-service against your own staff.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# --- sandbox demo access ----------------------------------------------------

# Passwordless persona switching for sandbox demos. This endpoint used to be
# gated only by NODE_ENV, which defaults to `development`, so it was effectively
# open impersonation of any account including privileged ones.
# It now returns 404 unless DEMO_MODE=true AND DEMO_SEED_SECRET is set AND the
# process is not production; it also demands a matching x-demo-secret header and
# refuses any persona whose derived roles are privileged.
# true in production = the app refuses to boot. Leave it false unless you are
# knowingly running a throwaway sandbox with throwaway data.
DEMO_MODE=false

# Shared secret the demo endpoint requires in the x-demo-secret header.
# Minimum 16 characters; DEMO_MODE=true without it is a boot error.
# Generate with:  openssl rand -hex 24
# DEMO_SEED_SECRET=

# --- health data ------------------------------------------------------------

# Reserved for at-rest encryption of the health schema. No code path encrypts
# anything with it today, so setting it does not make the health tables
# encrypted — do not treat its presence as a control.
# HEALTH_DATA_ENCRYPTION_KEY=

# Reserved signing key for a future separate health service. Unused today; if
# you set it, treat it with the same care as JWT_SECRET.
# HEALTH_SERVICE_JWT_SECRET=

# --- audit trail ------------------------------------------------------------

# How long audit rows are retained, in days (2555 ≈ 7 years).
# Shorter than your statutory retention period is a compliance failure; the
# audit table is also hash-chained and append-only, so pruning must be done by
# a deliberate, recorded process rather than an ad-hoc DELETE (which the
# triggers reject outright).
AUDIT_LOG_RETENTION_DAYS=2555

# When true, a failed audit write aborts the operation that triggered it.
# The writer used to swallow failures while its own docstring claimed
# fail-closed, so actions could happen with no record. false means you are
# choosing availability over an evidentiary trail; production refuses it.
AUDIT_FAIL_CLOSED=true

# --- organisation and payroll defaults --------------------------------------

# Single authoritative timezone for civil-day boundaries: attendance days, leave
# dates, payroll periods. Per-person overrides come from health.persons.timezone.
# Wrong value = clock-ins land on the wrong day, leave spans the wrong dates and
# payroll periods cut in the wrong place. Never rely on the server's local zone.
ORG_TIMEZONE=Asia/Kolkata

# Statutory payroll jurisdiction. Selects which deduction engine and which
# configuration tables from migrations/031_payroll_statutory.sql apply.
# A jurisdiction with no seeded rates produces payslips with no statutory
# deductions at all — which is what this system did before 2026-08-22.
PAYROLL_JURISDICTION=IN

# NEW | OLD Indian income-tax regime, used for TDS slabs.
# The seeded rates (EPF, ESI, professional tax, TDS slabs) are a starting point
# and MUST be verified by a qualified accountant before anyone is paid from them.
PAYROLL_TAX_REGIME=NEW

# --- feature flags ----------------------------------------------------------
# Parsed strictly: only true/false/1/0/yes/no/on/off. An unrecognised value is a
# boot error rather than a silent default — these flags previously used a
# truthiness coercion in which the string "false" enabled the feature.

# 3D organisation view. Heavy lazy-loaded bundle; off by default.
FEATURE_3D_ENABLED=false

# Reserved for a future language model. THERE IS NO LLM IN THIS SYSTEM: the
# "AI" care advisor and concierge are deterministic keyword matchers with no
# outbound network call. Turning this on does not add intelligence.
FEATURE_AI_ENABLED=false

# Workforce simulation surfaces. Off by default.
FEATURE_WORKFORCE_SIMULATION=false
